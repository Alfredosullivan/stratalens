# Plantilla de variables de entorno. Copia este archivo a .env y ajusta los valores.
# .env está en .gitignore: NUNCA se versiona con credenciales reales.

# --- Postgres local (docker-compose) ---
POSTGRES_USER=observability
POSTGRES_PASSWORD=cambia_esto_en_local
POSTGRES_DB=observability_map

# --- Cadena de conexión que usa el backend (host 5433, ver docker-compose.yml) ---
# Debe coincidir con las credenciales de arriba.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=observability_map;Username=observability;Password=cambia_esto_en_local
